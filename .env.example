# Copy to .env and edit. All settings are also readable as env vars (prefix ARGOS_).

# --- Server ---
ARGOS_HOST=0.0.0.0
ARGOS_PORT=8080
# API key for the web UI / API. Leave blank to auto-generate on first run.
ARGOS_API_KEY=
# Comma-separated allowed CORS origins (do NOT use * on a networked box).
ARGOS_CORS_ORIGINS=http://localhost:5173

# --- Storage ---
ARGOS_DATA_DIR=./data
ARGOS_MODELS_DIR=./models/weights

# --- Inference (AMD GPU via DirectML) ---
# dml:0 = first GPU adapter, dml:1 = second, cpu = CPU fallback.
ARGOS_DEVICE=dml:0
ARGOS_PREFER_FP16=true
# Min free VRAM (MB) before admitting another concurrent inference job.
ARGOS_MIN_FREE_VRAM_MB=768
ARGOS_GPU_CONCURRENCY=2

# --- Ingest: 'frigate' (recommended) or 'rtsp' ---
ARGOS_INGEST=frigate

# Frigate consumer
ARGOS_FRIGATE_URL=http://frigate.lan:5000
ARGOS_MQTT_HOST=frigate.lan
ARGOS_MQTT_PORT=1883
# ARGOS_MQTT_USER=
# ARGOS_MQTT_PASSWORD=

# Direct RTSP (HiLook/Hikvision). name=url pairs, ';'-separated. Point at sub-streams (…02).
# ARGOS_RTSP_CAMERAS=front=rtsp://user:pass@dvr.lan:554/Streaming/Channels/102;yard=rtsp://user:pass@dvr.lan:554/Streaming/Channels/202

# --- Analyzers (enable/disable) ---
ARGOS_ENABLE_POSE=true
ARGOS_ENABLE_ACTION=true
ARGOS_ENABLE_FACE=true
ARGOS_ENABLE_REID=true
ARGOS_ENABLE_GAIT=false

# --- Notifications (generic JSON webhook: ntfy / Home Assistant / Discord / Telegram-bot / Slack) ---
# Leave blank to disable. Example ntfy: https://ntfy.sh/your-topic
ARGOS_NOTIFY_WEBHOOK_URL=
# Which event kinds notify (comma-separated): behavior, new_person, recognized, zone
ARGOS_NOTIFY_ON=behavior,new_person,zone
# Suppress repeats for the same person/camera within this many seconds (avoids alert fatigue).
ARGOS_NOTIFY_COOLDOWN_S=300

# --- Privacy / retention (days) ---
ARGOS_RETAIN_CROPS_DAYS=14
ARGOS_RETAIN_EMBEDDINGS_DAYS=30
ARGOS_RETAIN_EVENTS_DAYS=90
